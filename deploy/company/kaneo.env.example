# 사내 Kaneo(kaneo.vanpharm.com) 환경변수 예시. 복사해서 kaneo.env 로 쓴다.
#   cp kaneo.env.example kaneo.env && chmod 600 kaneo.env
# 실제 값이 든 kaneo.env 는 커밋하지 않는다.
# 아래 이름은 apps/api 코드가 실제로 읽는 이름이다. 주석 처리된 항목은 기본값으로 충분한 것.

# ── 공개 주소 ─────────────────────────────────────────────────────────
# 이 인스턴스의 외부 주소. 로그인 리다이렉트·초대 링크·MCP discovery 의 기준값이다.
KANEO_CLIENT_URL=https://kaneo.vanpharm.com
# 비워 둔다. 엔트리포인트가 KANEO_CLIENT_URL + /api 로 파생시킨다. 직접 지정하면 브라우저 API 호출이 깨질 수 있다.
KANEO_API_URL=
# 번들 이미지는 web 과 api 가 같은 오리진이라 CORS 설정이 필요 없다. 다른 오리진에서 API 를 부를 때만 콤마 목록으로 지정한다.
# CORS_ORIGINS=
NODE_ENV=production

# ── 인증 비밀키 ───────────────────────────────────────────────────────
# better-auth 서명 키. 32자 이상이어야 하며 미만이면 기동이 즉시 실패한다. `openssl rand -hex 32` 로 생성한다.
# 비워 두면 엔트리포인트가 매 기동마다 랜덤 생성해 재시작 때 모든 세션이 끊긴다.
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── 데이터베이스 ──────────────────────────────────────────────────────
# postgres 컨테이너와 kaneo 컨테이너가 이 값을 함께 읽는다. 호스트 이름은 compose 서비스명이다.
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# 외부 Postgres 를 쓸 때만 직접 지정한다. 지정하면 위 POSTGRES_* 파생이 무시된다.
# 세션 타임존은 코드가 UTC 로 고정하므로 options= 쿼리를 붙이지 않는다.
# DATABASE_URL=postgresql://user:pass@host:5432/kaneo

# ── 가입·로그인 정책 ──────────────────────────────────────────────────
# 사내 인스턴스는 자가 가입을 막는다. 단, 사용자가 0명일 때 첫 가입 1건은 관리자 부트스트랩으로 허용된다.
# 주의: true 로 두면 초대 없는 신규 유저 생성이 막혀 mcp.vanpharm.com 로그인이 두 번째 유저부터
# 실패한다(자동 편입 훅은 유저 생성 뒤에 돈다). 가입 경로는 아래 DISABLE_PASSWORD_REGISTRATION·
# DISABLE_LOGIN_FORM 으로 잠그고, 누가 들어올 수 있는지는 mcp 의 kaneo 권한이 결정한다.
DISABLE_REGISTRATION=false
# 비로그인 게스트 접근을 막는다.
DISABLE_GUEST_ACCESS=true
# 이메일+비밀번호 신규 가입만 따로 막을 때 쓴다. DISABLE_REGISTRATION 이 true 면 사실상 중복이다.
DISABLE_PASSWORD_REGISTRATION=true
# 이메일 OTP 로그인을 끈다. SMTP 를 붙이지 않을 거면 true 로 둔다.
DISABLE_EMAIL_OTP_SIGN_IN=true
# 로그인 화면에서 아이디/비밀번호 폼 자체를 숨긴다. OAuth 만 쓸 때 true. 잠금 위험이 있어 기본은 주석.
# DISABLE_LOGIN_FORM=true
# 워크스페이스 생성을 인스턴스 관리자로 제한한다.
# DISABLE_WORKSPACE_CREATION=true

# ── 사내 OAuth(Custom OAuth) ──────────────────────────────────────────
# Kaneo 는 자체 회원가입을 쓰지 않는다. 로그인을 mcp.vanpharm.com 에 위임하고,
# mcp 에서 `kaneo` 권한을 받은 사람만 토큰을 받아 로그인에 성공한다.
# 따라서 Kaneo 쪽 접근 통제는 이 블록과 아래 자동 편입 설정이 전부다.
# CLIENT_ID 와 CLIENT_SECRET 이 둘 다 있어야 로그인 화면에 OAuth 버튼이 나타난다.
CUSTOM_OAUTH_CLIENT_ID=CHANGE_ME_client_id
CUSTOM_OAUTH_CLIENT_SECRET=CHANGE_ME_client_secret
# mcp.vanpharm.com 은 OIDC discovery 문서를 제공하지 않으므로 세 주소를 직접 적는다.
# better-auth genericOAuth 는 discoveryUrl 없이 authorization/token URL 만 있으면 동작하고,
# userinfo 는 id_token 이 없거나 id_token 에 sub·email 이 없을 때 호출된다.
CUSTOM_OAUTH_AUTHORIZATION_URL=https://mcp.vanpharm.com/authorize
CUSTOM_OAUTH_TOKEN_URL=https://mcp.vanpharm.com/token
CUSTOM_OAUTH_USER_INFO_URL=https://mcp.vanpharm.com/oauth/userinfo
# discovery 를 제공하는 IdP 로 갈아탈 때만 지정한다. 지정하면 위 세 주소를 덮어쓴다.
# CUSTOM_OAUTH_DISCOVERY_URL=
# 요청 스코프. 콤마로 구분한다. mcp 는 kaneo 로그인 전용 스코프 하나만 쓴다.
CUSTOM_OAUTH_SCOPES=kaneo:login
# userinfo(또는 id_token) 응답에서 읽는 필드:
#   sub 또는 id  → 계정 식별자 (없으면 로그인이 id_is_missing 으로 실패)
#   email        → 사용자 이메일
#   name         → 표시 이름 (없으면 given_name+family_name → preferred_username →
#                  이메일 앞부분 순으로 Kaneo 가 대체한다)
#   picture      → 아바타
#   email_verified → 없으면 false 로 처리된다
# email_verified 가 true 가 아니면 초대 자동 수락과 아래 워크스페이스 자동 편입이
# 모두 건너뛰어져, 직원은 로그인은 되지만 워크스페이스가 없는 상태가 된다.
# 로그인 화면을 거치지 않고 바로 IdP 로 보낸다. IdP 설정이 틀리면 로그인 자체가 막히니 검증 후 켠다.
CUSTOM_OAUTH_AUTO_LOGIN=true
# 로그아웃 시 IdP 세션까지 끊을 주소. 비우면 Kaneo 세션만 끊는다.
# mcp.vanpharm.com 에 이 엔드포인트가 실제로 있는지는 아직 확인되지 않았다. 확인 전에는 주석으로 둔다.
# CUSTOM_OAUTH_LOGOUT_URL=https://mcp.vanpharm.com/logout
# 기본 code. 바꿀 일이 거의 없다.
# CUSTOM_OAUTH_RESPONSE_TYPE=code
# PKCE 는 기본 사용이다. IdP 가 지원하지 않을 때만 false 로 끈다.
# CUSTOM_AUTH_PKCE=false

# ── 워크스페이스 자동 편입 ────────────────────────────────────────────
# 사내 인스턴스는 Kaneo 초대 단계를 쓰지 않는다. custom OAuth 로 처음 로그인해서
# 사용자 레코드가 만들어지는 순간, 이 워크스페이스에 멤버로 넣는다.
# 비워 두면 자동 편입이 꺼지고, 직원은 초대를 받아야 워크스페이스가 생긴다.
# 값은 워크스페이스 slug 가 아니라 workspace.id 다.
CUSTOM_OAUTH_AUTO_JOIN_WORKSPACE_ID=
# 자동 편입 시 부여할 역할. 비우면 member. 해당 워크스페이스에 실제로 존재하는
# 역할 slug 여야 한다(owner 또는 workspace_role 에 시드된 admin/member/viewer).
# CUSTOM_OAUTH_AUTO_JOIN_ROLE=member
# 적용 조건:
#   - genericOAuth `custom` 콜백(/oauth2/callback/custom)에서만 동작한다. 소셜 로그인은 제외.
#   - email_verified 가 true 여야 한다.
#   - 이미 그 워크스페이스 멤버면(예: 초대를 방금 자동 수락) 건너뛴다.
#   - 신규 사용자 생성 시점에만 돈다. 값을 나중에 바꿔도 기존 사용자는 편입되지 않는다.

# ── MCP / 리버스 프록시 ───────────────────────────────────────────────
# device flow 를 허용할 client_id 목록. 비우면 kaneo-cli,kaneo-mcp 가 기본값이다.
# DEVICE_AUTH_CLIENT_IDS=kaneo-cli,kaneo-mcp
# 클라이언트 IP 판정에 신뢰할 프록시 대역. 비우면 127.0.0.0/8,::1/128,10/8,172.16/12,192.168/16 이 기본이라 사내 구성에는 그대로 맞는다.
# TRUSTED_PROXIES=
# 세션 쿠키를 상위 도메인과 공유할 때만 지정한다. 단일 호스트면 비워 둔다.
# COOKIE_DOMAIN=

# ── SMTP (초대 메일·알림) ─────────────────────────────────────────────
# SMTP_HOST 와 SMTP_FROM 이 둘 다 있어야 메일 발송이 활성화된다. 없으면 초대는 링크 복사로만 가능하다.
# SMTP_HOST=smtp.vanpharm.com
# SMTP_PORT=587
# SMTP_FROM=kaneo@vanpharm.com
# SMTP_USER=
# SMTP_PASSWORD=
# 기본이 true(implicit TLS). 587 STARTTLS 를 쓸 때는 false 로 두고 SMTP_REQUIRE_TLS=true 를 켠다.
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# 사내 릴레이가 TLS 를 아예 지원하지 않을 때만 true.
# SMTP_IGNORE_TLS=false

# ── 첨부 스토리지 (선택, 후속 과제) ───────────────────────────────────
# S3_ENDPOINT 와 S3_BUCKET 이 없으면 첨부·산출물 업로드가 503 이다. 그 외 기능은 정상 동작한다.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# MinIO 등 path-style 스토리지는 true. 기본값이 true 다.
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=
# S3_PRESIGN_TTL_SECONDS=
# S3_MAX_IMAGE_UPLOAD_BYTES=
# 산출물 다운로드 URL 유효시간(초).
# AGENT_ARTIFACT_URL_TTL_SECONDS=
